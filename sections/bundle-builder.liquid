</style>
<script src="{{ 'bundle-builder.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Bundle Builder",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Let's get started!"
    }
  ],
  "blocks": [
    {
      "type": "bundle_product",
      "name": "Bundle Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "select",
          "id": "category",
          "label": "Category / Step",
          "options": [
            { "value": "Cameras", "label": "Cameras" },
            { "value": "Plan", "label": "Plan" },
            { "value": "Sensors", "label": "Sensors" },
            { "value": "Accessories", "label": "Accessories" }
          ],
          "default": "Cameras"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Title (optional)"
        },
        {
          "type": "textarea",
          "id": "custom_description",
          "label": "Custom Description (optional)"
        },
        {
          "type": "text",
          "id": "custom_price",
          "label": "Custom Price (dollars, e.g. 27.98) (optional)"
        },
        {
          "type": "text",
          "id": "custom_compare_at_price",
          "label": "Custom Compare-at Price (dollars, e.g. 35.98) (optional)"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Custom Badge Text (e.g. Save 22%) (optional)"
        },
        {
          "type": "url",
          "id": "learn_more_url",
          "label": "Learn More URL (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle Builder"
    }
  ]
}
{% endschema %}
