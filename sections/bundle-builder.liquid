<div class="bundle-builder-section" id="bundle-builder-container">
  {% comment %} 
    Mount point for the React App 
  {% endcomment %}
  <div id="react-bundle-builder-root"></div>
</div>

{% comment %} 
  Inject dynamic product data as JSON so the React app can read it on mount.
  We iterate over the blocks added by the user in the Theme Customizer.
{% endcomment %}
<script type="application/json" id="bundle-builder-data">
  {
    "sectionSettings": {
      "heading": {{ section.settings.heading | json }}
    },
    "assetUrls": {
      "satisfactionBadge": {{ 'satisfaction-badge.png' | asset_url | json }},
      "Wyze Cam v4-white": {{ 'Wyze Cam v4-white.png' | asset_url | json }},
      "Wyze Cam v4-grey": {{ 'Wyze Cam v4-grey.png' | asset_url | json }},
      "Wyze Cam v4-black": {{ 'Wyze Cam v4-black.png' | asset_url | json }},
      "Wyze Cam Pan v3-white": {{ 'Wyze Cam Pan v3-white.png' | asset_url | json }},
      "Wyze Cam Pan v3-black": {{ 'Wyze Cam Pan v3-black.png' | asset_url | json }},
      "Wyze Cam Floodlight v2-black": {{ 'Wyze Cam Floodlight v2-black.png' | asset_url | json }},
      "Wyze Battery Cam Pro-black": {{ 'Wyze Battery Cam Pro-black.png' | asset_url | json }}
    },
    "products": [
      {% assign first = true %}
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        {% if product != blank %}
          {% if first == false %},{% endif %}
          {%- liquid
            assign title = block.settings.custom_title | default: product.title
            assign description = block.settings.custom_description | default: product.description | strip_html
            assign learn_more_url = block.settings.learn_more_url | default: product.url
            assign badge_text = block.settings.badge_text
            assign price = product.price
            assign compare_at_price = product.compare_at_price
            if block.settings.custom_price != blank
              assign price = block.settings.custom_price | times: 100 | round
            endif
            if block.settings.custom_compare_at_price != blank
              assign compare_at_price = block.settings.custom_compare_at_price | times: 100 | round
            endif
          -%}
          {
            "id": {{ product.id | json }},
            "blockId": {{ block.id | json }},
            "title": {{ title | json }},
            "description": {{ description | json }},
            "learnMoreUrl": {{ learn_more_url | json }},
            "badgeText": {{ badge_text | json }},
            "price": {{ price | json }},
            "compare_at_price": {{ compare_at_price | json }},
            "variants": {{ product.variants | json }},
            "images": [
              {% for image in product.images %}
                {{ image.src | image_url: width: 800 | json }}{% unless forloop.last %},{% endunless %}
              {% endfor %}
            ],
            "category": {{ block.settings.category | json }}
          }
          {% assign first = false %}
        {% endif %}
      {% endfor %}
    ]
  }
</script>

{% comment %} 
  Load the compiled React assets (these are built by Vite)
{% endcomment %}
{{ 'bundle-builder.css' | asset_url | stylesheet_tag }}
<style>
  @font-face {
    font-family: 'Gilroy-Bold';
