<div class="bundle-builder-section" id="bundle-builder-container">
  {% comment %} 
    Mount point for the React App 
  {% endcomment %}
  <div id="react-bundle-builder-root"></div>
</div>

{% comment %} 
  Inject dynamic product data and customizer settings as JSON so the React app can read it on mount.
{% endcomment %}
<script type="application/json" id="bundle-builder-data">
  {
    "sectionSettings": {{ section.settings | json }},
    "assetUrls": {
      "satisfactionBadge": {{ 'satisfaction-badge.png' | asset_url | json }},
      "Wyze Cam v4-white": {{ 'Wyze Cam v4-white.png' | asset_url | json }},
      "Wyze Cam v4-grey": {{ 'Wyze Cam v4-grey.png' | asset_url | json }},
      "Wyze Cam v4-black": {{ 'Wyze Cam v4-black.png' | asset_url | json }},
      "Wyze Cam Pan v3-white": {{ 'Wyze Cam Pan v3-white.png' | asset_url | json }},
      "Wyze Cam Pan v3-black": {{ 'Wyze Cam Pan v3-black.png' | asset_url | json }},
      "Wyze Cam Floodlight v2-black": {{ 'Wyze Cam Floodlight v2-black.png' | asset_url | json }},
      "Wyze Battery Cam Pro-black": {{ 'Wyze Battery Cam Pro-black.png' | asset_url | json }}
    },
    "products": [
      {% assign first = true %}
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        {% if product != blank %}
          {% if first == false %},{% endif %}
          {%- liquid
            assign title = block.settings.custom_title | default: product.title
            assign description = block.settings.custom_description | default: product.description | strip_html
            assign learn_more_url = block.settings.learn_more_url | default: product.url
            assign badge_text = block.settings.badge_text
            assign price = product.price
            assign compare_at_price = product.compare_at_price
            if block.settings.custom_price != blank
              assign price = block.settings.custom_price | times: 100 | round
            endif
            if block.settings.custom_compare_at_price != blank
              assign compare_at_price = block.settings.custom_compare_at_price | times: 100 | round
            endif
            assign image_offset_y = block.settings.custom_image_offset_y | default: 0
            assign image_padding = block.settings.custom_image_padding | default: 0
          -%}
          {
            "id": {{ product.id | json }},
            "blockId": {{ block.id | json }},
            "title": {{ title | json }},
            "description": {{ description | json }},
            "learnMoreUrl": {{ learn_more_url | json }},
            "badgeText": {{ badge_text | json }},
            "price": {{ price | json }},
            "compare_at_price": {{ compare_at_price | json }},
            "variants": {{ product.variants | json }},
            "images": [
              {% for image in product.images %}
                {{ image.src | image_url: width: 800 | json }}{% unless forloop.last %},{% endunless %}
              {% endfor %}
            ],
            "category": {{ block.settings.category | json }},
            "imageOffsetY": {{ image_offset_y | json }},
            "imagePadding": {{ image_padding | json }}
          }
          {% assign first = false %}
        {% endif %}
      {% endfor %}
    ]
  }
</script>

{% comment %} 
  Load the compiled React assets (these are built by Vite)
{% endcomment %}
{{ 'bundle-builder.css' | asset_url | stylesheet_tag }}
<style>
  @font-face {
    font-family: 'Gilroy-Bold';
    src: url("{{ 'Gilroy-Bold.ttf' | asset_url }}") format('truetype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Gilroy-Medium';
    src: url("{{ 'Gilroy-Medium.ttf' | asset_url }}") format('truetype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Gilroy-medium';
    src: url("{{ 'Gilroy-Medium.ttf' | asset_url }}") format('truetype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Gilroy-SemiBold';
    src: url("{{ 'Gilroy-Medium.ttf' | asset_url }}") format('truetype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Gilroy-semibold';
    src: url("{{ 'Gilroy-Medium.ttf' | asset_url }}") format('truetype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Gilroy-Regular';
    src: url("{{ 'Gilroy-Regular.ttf' | asset_url }}") format('truetype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Gilroy-Light';
    src: url("{{ 'Gilroy-Light.ttf' | asset_url }}") format('truetype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Gilroy-Heavy';
    src: url("{{ 'Gilroy-Heavy.ttf' | asset_url }}") format('truetype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
</style>
<script src="{{ 'bundle-builder.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Bundle Builder",
  "settings": [
    {
      "type": "header",
      "content": "Heading Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Let's get started!"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Font Size",
      "min": 20,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1F1F1F"
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "label": "Heading Bottom Spacing",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Step Header Settings"
    },
    {
      "type": "select",
      "id": "step_title_font_family",
      "label": "Step Title Font Family",
      "options": [
        { "value": "Gilroy-semibold", "label": "Gilroy SemiBold" },
        { "value": "Gilroy-Bold", "label": "Gilroy Bold" },
        { "value": "Gilroy-Medium", "label": "Gilroy Medium" },
        { "value": "Gilroy-Regular", "label": "Gilroy Regular" }
      ],
      "default": "Gilroy-semibold"
    },
    {
      "type": "range",
      "id": "step_title_font_size",
      "label": "Step Title Font Size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "step_title_color",
      "label": "Step Title Color",
      "default": "#0B0D10"
    },
    {
      "type": "range",
      "id": "step_header_padding_y",
      "label": "Step Header Vertical Padding",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Selection Counter Settings"
    },
    {
      "type": "range",
      "id": "selected_count_font_size",
      "label": "Selected Count Font Size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "selected_count_color",
      "label": "Selected Count Color",
      "default": "#4E2FD2"
    },
    {
      "type": "select",
      "id": "selected_count_font_family",
      "label": "Selected Count Font Family",
      "options": [
        { "value": "Gilroy-Medium", "label": "Gilroy Medium" },
        { "value": "Gilroy-Bold", "label": "Gilroy Bold" },
        { "value": "Gilroy-Regular", "label": "Gilroy Regular" }
      ],
      "default": "Gilroy-Medium"
    },
    {
      "type": "header",
      "content": "Product Card Settings"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border Color (Unselected)",
      "default": "#CED6DE"
    },
    {
      "type": "color",
      "id": "card_selected_border_color",
      "label": "Card Border Color (Selected)",
      "default": "#4E2FD2"
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card Padding",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card Border Radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Product Image Placement & Size"
    },
    {
      "type": "range",
      "id": "card_image_width",
      "label": "Image Container Width",
      "min": 80,
      "max": 180,
      "step": 5,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "card_image_height",
      "label": "Image Container Height",
      "min": 80,
      "max": 180,
      "step": 5,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "card_image_offset_y",
      "label": "Image Vertical Offset (Move Up/Down)",
      "min": -30,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "card_image_padding",
      "label": "Image Inner Padding",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Product Typography"
    },
    {
      "type": "select",
      "id": "card_title_font_family",
      "label": "Product Title Font Family",
      "options": [
        { "value": "Gilroy-Bold", "label": "Gilroy Bold" },
        { "value": "Gilroy-SemiBold", "label": "Gilroy SemiBold" },
        { "value": "Gilroy-Medium", "label": "Gilroy Medium" },
        { "value": "Gilroy-Regular", "label": "Gilroy Regular" }
      ],
      "default": "Gilroy-Bold"
    },
    {
      "type": "range",
      "id": "card_title_font_size",
      "label": "Product Title Font Size",
      "min": 13,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Product Title Color",
      "default": "#1F1F1F"
    },
    {
      "type": "range",
      "id": "card_desc_font_size",
      "label": "Description Font Size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "card_desc_color",
      "label": "Description Color",
      "default": "#6F7882"
    }
  ],
  "blocks": [
    {
      "type": "bundle_product",
      "name": "Bundle Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "select",
          "id": "category",
          "label": "Category / Step",
          "options": [
            { "value": "Cameras", "label": "Cameras" },
            { "value": "Plan", "label": "Plan" },
            { "value": "Sensors", "label": "Sensors" },
            { "value": "Accessories", "label": "Accessories" }
          ],
          "default": "Cameras"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Title (optional)"
        },
        {
          "type": "textarea",
          "id": "custom_description",
          "label": "Custom Description (optional)"
        },
        {
          "type": "text",
          "id": "custom_price",
          "label": "Custom Price (dollars, e.g. 27.98) (optional)"
        },
        {
          "type": "text",
          "id": "custom_compare_at_price",
          "label": "Custom Compare-at Price (dollars, e.g. 35.98) (optional)"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Custom Badge Text (e.g. Save 22%) (optional)"
        },
        {
          "type": "url",
          "id": "learn_more_url",
          "label": "Learn More URL (optional)"
        },
        {
          "type": "range",
          "id": "custom_image_offset_y",
          "label": "Product Image Offset Y (Move Up/Down)",
          "min": -30,
          "max": 30,
          "step": 2,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "custom_image_padding",
          "label": "Product Image Inner Padding",
          "min": 0,
          "max": 24,
          "step": 2,
          "unit": "px",
          "default": 0
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle Builder"
    }
  ]
}
{% endschema %}
