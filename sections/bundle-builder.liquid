<div class="bundle-builder-section" id="bundle-builder-container">
  {% comment %} 
    Mount point for the React App 
  {% endcomment %}
  <div id="react-bundle-builder-root"></div>
</div>

{% comment %} 
  Inject dynamic product data as JSON so the React app can read it on mount.
  We iterate over the blocks added by the user in the Theme Customizer.
{% endcomment %}
<script type="application/json" id="bundle-builder-data">
  {
    "sectionSettings": {
      "heading": {{ section.settings.heading | json }}
    },
    "products": [
      {% assign first = true %}
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        {% if product != blank %}
          {% if first == false %},{% endif %}
          {
            "id": {{ product.id | json }},
            "title": {{ product.title | json }},
            "price": {{ product.price | json }},
            "compare_at_price": {{ product.compare_at_price | json }},
            "variants": {{ product.variants | json }},
            "images": [
              {% for image in product.images %}
                {{ image.src | image_url | json }}{% unless forloop.last %},{% endunless %}
              {% endfor %}
            ],
            "category": {{ block.settings.category | json }}
          }
          {% assign first = false %}
        {% endif %}
      {% endfor %}
    ]
  }
</script>

{% comment %} 
  Load the compiled React assets (these are built by Vite)
{% endcomment %}
<script src="{{ 'bundle-builder.js' | asset_url }}" defer="defer"></script>
{{ 'bundle-builder.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Bundle Builder",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Let's get started!"
    }
  ],
  "blocks": [
    {
      "type": "bundle_product",
      "name": "Bundle Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "select",
          "id": "category",
          "label": "Category / Step",
          "options": [
            { "value": "Cameras", "label": "Cameras" },
            { "value": "Plan", "label": "Plan" },
            { "value": "Sensors", "label": "Sensors" },
            { "value": "Accessories", "label": "Accessories" }
          ],
          "default": "Cameras"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle Builder"
    }
  ]
}
{% endschema %}
